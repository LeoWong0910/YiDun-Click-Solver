# Copy to .env before deploying (never commit real secrets).
# Synology one-click deploy reads these values.

# NAS SSH target, e.g. admin@192.168.1.50 or user@nas.local
NAS_SSH=admin@192.168.1.50

# Remote project directory on the NAS volume.
NAS_DIR=/volume1/docker/yidun-click-solver

# Published host port on the NAS.
HOST_PORT=8765

# Optional API bearer token. Leave empty to disable auth (LAN-only recommended).
YIDUN_API_TOKEN=

# Solver defaults
YIDUN_MAX_ATTEMPTS=10
YIDUN_SOLVE_TIMEOUT=120
YIDUN_ZONE_ID=CN31
